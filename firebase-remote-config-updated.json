  "faqs": [
    {"question": "Is fuel included in the rental price?", "answer": "Yes! Fuel cost is included in the base fare. You don't need to worry about fuel expenses during your trip."},
    {"question": "What are Night Charges?", "answer": "A flat fee of ₹300 applies for trips that include driving between 10 PM and 6 AM. This covers the driver's night duty allowance."},
    {"question": "Does the price include Driver Allowance?", "answer": "The base fare includes car rent and fuel. Driver daily allowance (Batta) of ₹350/day is charged separately and payable directly to the driver."},
    {"question": "Are Toll and Parking charges included?", "answer": "No. All toll taxes, state entry permits, and parking fees are to be paid by the guest as per actuals during the trip."},
    {"question": "Can I drive the car myself?", "answer": "No. All our cars are strictly Chauffeur-driven. We do not provide Self-Drive cars."},
    {"question": "What happens if I exceed the hours booked?", "answer": "Extra hours will be charged at the standard hourly rate for that specific car model."}
  ]
